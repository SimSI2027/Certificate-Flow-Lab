{
  "name": "certificate-flow-lab",
  "version": "0.2.0",
  "description": "Interactive certificate issuance, deployment and trust visualization (synthetic simulation)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures:generate": "node scripts/generate-fixtures/generate.mjs",
    "fixtures:validate": "node scripts/validation/validate-fixtures.mjs",
